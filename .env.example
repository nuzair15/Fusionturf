# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fusion_league

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
MFA_ENCRYPTION_KEY=use-a-different-long-random-secret
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (SendGrid / SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
EMAIL_FROM=noreply@fusionturf.com
# SMTP credentials are required by the configured provider (for Gmail use an
# app password as SMTP_PASS); missing values cause Nodemailer "Missing
# credentials for PLAIN" errors.
ADMIN_BOOKING_EMAIL=bookings@example.com

# WhatsApp / Twilio
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_WHATSAPP_NUMBER=+14155238886

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Redis (optional)
REDIS_URL=redis://localhost:6379

# --- Only needed for docker-compose.prod.yml (production deploy) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=fusion_league
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# The destructive demo reset additionally requires
# DESTRUCTIVE_SEED_CONFIRM=RESET_FUSION_LEAGUE and explicit DEMO_* credentials.
DESTRUCTIVE_SEED_CONFIRM=
ALLOW_REMOTE_DESTRUCTIVE_SEED=false
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
DEMO_MANAGER_EMAIL=
DEMO_MANAGER_PASSWORD=
# The URL the built client bundle should call -- baked in at build time,
# not read at container start (see client/Dockerfile).
VITE_API_URL=http://localhost:5000/api
