DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fusion_league
JWT_SECRET=replace-with-a-long-random-secret
MFA_ENCRYPTION_KEY=replace-with-a-different-long-random-secret
REQUIRE_PRIVILEGED_MFA=true
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Destructive demo reset (npm run db:reset-demo). Keep confirmation blank
# unless you intentionally want to erase every application table.
DESTRUCTIVE_SEED_CONFIRM=
ALLOW_REMOTE_DESTRUCTIVE_SEED=false
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
DEMO_MANAGER_EMAIL=
DEMO_MANAGER_PASSWORD=
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# SMTP (Gmail requires an app password, not the normal account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
ADMIN_BOOKING_EMAIL=

# Required for image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
