DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fusion_league
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_PANEL_PASSWORD=replace-with-a-strong-admin-password
# Email used for the one shared "break glass" admin account created on first
# admin-panel login. Recommended: replace the shared-password admin login
# with individual admin accounts (via /auth/register + role assignment) and
# retire this entirely.
ADMIN_PANEL_EMAIL=super-admin@fusionturf.internal
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Required for image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required for online payment collection (POST /api/bookings/:id/payment-intent
# and POST /api/webhooks/stripe). Without these, bookings can still be
# created but no online payment can be captured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
