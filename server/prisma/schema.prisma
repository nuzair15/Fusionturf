generator client {
  provider      = "prisma-client-js"
  // Restrict downloaded query-engine binaries to what's actually used:
  // "native" covers local dev on whatever OS you're developing on, and
  // "linux-musl-openssl-3.0.x" covers the Alpine-based Docker image this
  // project ships (node:20-alpine). Without this, `prisma generate` fetches
  // engine binaries for every platform Prisma supports (Debian/RHEL/etc,
  // ~50-80MB each) into node_modules, which get shipped into the runtime
  // image even though only one of them is ever executed. Pinning this
  // shrinks node_modules considerably and cuts image size/startup disk I/O.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  LEAGUE_ADMIN
  BOOKING_MANAGER
  CONTENT_EDITOR
  REFEREE
  STATISTICIAN
  VIEWER
  CUSTOMER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  RESCHEDULED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
  PARTIALLY_REFUNDED
}

enum MatchStatus {
  SCHEDULED
  LIVE
  PAUSED
  HALF_TIME
  EXTRA_TIME
  PENALTIES
  COMPLETED
  CANCELLED
  POSTPONED
}

enum SquadType {
  STARTER
  SUBSTITUTE
  RESERVE
}

enum SuspensionReason {
  YELLOW_ACCUMULATION
  STRAIGHT_RED
  SECOND_YELLOW
  VIOLENT_CONDUCT
  SERIOUS_MISCONDUCT
}

enum AwardVotingType {
  PUBLIC
  REGISTERED_ONLY
  ADMIN_ONLY
  DISABLED
}

enum VoteFrequency {
  ONCE
  ONCE_PER_DAY
  ONCE_PER_DEVICE
  ONCE_PER_ACCOUNT
  MULTIPLE
}

enum VoteStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FixtureCompetition {
  LEAGUE
  CUP
  FRIENDLY
  KNOCKOUT
  OTHER
}

// New v2 domain enums are additive. Legacy v1 tables continue to operate
// while data is backfilled into the permanent-identity/event-stream model.
enum RegistrationStatus {
  ACTIVE
  SUSPENDED
  RELEASED
  EXPIRED
}

enum SchedulePreviewStatus {
  DRAFT
  PUBLISHED
  EXPIRED
  FAILED
}

enum MatchEventType {
  GOAL
  OWN_GOAL
  PENALTY_GOAL
  ASSIST
  YELLOW_CARD
  SECOND_YELLOW
  RED_CARD
  SUBSTITUTION
  NOTE
  CLOCK
  STATE_CHANGE
  CORRECTION
  REVERSAL
  SETTLEMENT
  SHOT
}

enum ShotOutcome {
  ON_TARGET
  OFF_TARGET
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  DEAD_LETTER
}

enum LedgerEntryType {
  PAYMENT_CAPTURED
  PAYMENT_REFUNDED
  PAYMENT_ADJUSTED
  COUPON_REDEEMED
  COUPON_RELEASED
}

// ──────────────────────────────────────────────────────────────
// USER & AUTH
// ──────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String?
  passwordHash  String
  firstName     String
  lastName      String
  avatarUrl     String?
  role          UserRole  @default(CUSTOMER)
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  mfaEnabled    Boolean   @default(false)
  mfaSecret     String?
  mfaEnrolledAt DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookings             Booking[]
  payments             Payment[]
  reviews              Review[]
  votes                Vote[]
  notifications        Notification[]
  activityLogs         ActivityLog[]
  comments             MatchComment[]
  refreshTokens        RefreshToken[]
  sentNotifications    Notification[]        @relation("SentNotifications")
  follows              UserFollow[]
  matchRsvps           MatchRsvp[]
  pollVotes            PollVote[]
  managedAwards        Award[]               @relation("ManagedAwards")
  managedSeasons       Season[]              @relation("ManagedSeasons")
  managedTeams         Team[]                @relation("ManagedTeams")
  matchResultRevisions MatchResultRevision[]
  playerTransfers      PlayerTransfer[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  token      String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  userAgent  String?
  ipAddress  String?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt, revokedAt])
  @@map("refresh_tokens")
}

// ──────────────────────────────────────────────────────────────
// RBAC
// ──────────────────────────────────────────────────────────────

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  module      String
  action      String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  role         UserRole
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@map("role_permissions")
}

// ──────────────────────────────────────────────────────────────
// TURF BOOKING
// ──────────────────────────────────────────────────────────────

model Venue {
  id                     String    @id @default(uuid())
  name                   String
  slug                   String    @unique
  description            String?
  address                String
  city                   String
  state                  String
  country                String    @default("India")
  zipCode                String?
  latitude               Float?
  longitude              Float?
  phone                  String?
  email                  String?
  coverImage             String?
  logo                   String?
  rules                  String?
  faqs                   Json?
  isActive               Boolean   @default(true)
  openingTime            String    @default("06:00")
  closingTime            String    @default("22:00")
  lastBookingTime        String? // latest time a booking can start; defaults to closingTime when null
  bookingMessageTemplate String? // WhatsApp message template for bookings
  timezone               String    @default("Asia/Kolkata")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?
  deletedById            String?
  deleteReason           String?

  turfs            Turf[]
  gallery          VenueGallery[]
  reviews          Review[]
  fixtures         Fixture[]
  workingHours     VenueWorkingHour[]
  blockedDates     BlockedDate[]
  pricingOverrides PricingOverride[]

  @@index([deletedAt])
  @@map("venues")
}

model VenueWorkingHour {
  id        String  @id @default(uuid())
  venueId   String
  venue     Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0=Sunday, 1=Monday ... 6=Saturday
  openTime  String
  closeTime String
  isClosed  Boolean @default(false)

  @@unique([venueId, dayOfWeek])
  @@map("venue_working_hours")
}

model Turf {
  id              String    @id @default(uuid())
  venueId         String
  venue           Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  size            String? // 5-a-side, 7-a-side, 11-a-side
  surface         String? // Natural, Artificial, etc.
  isActive        Boolean   @default(true)
  basePrice       Int       @default(500) // price in cents
  peakPrice       Int       @default(1000)
  weekendPrice    Int       @default(800)
  halfHourBilling Boolean   @default(false) // bill in 30-min increments (each = half hourly rate)
  imageUrl        String?
  capacity        Int       @default(22)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  deletedById     String?
  deleteReason    String?

  bookings           Booking[]
  slotAvailabilities SlotAvailability[]
  services           AdditionalService[]

  @@index([deletedAt])
  @@map("turfs")
}

model AdditionalService {
  id           String    @id @default(uuid())
  turfId       String
  turf         Turf      @relation(fields: [turfId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  price        Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  bookingServices BookingService[]

  @@index([deletedAt])
  @@map("additional_services")
}

model SlotAvailability {
  id        String   @id @default(uuid())
  turfId    String
  turf      Turf     @relation(fields: [turfId], references: [id], onDelete: Cascade)
  date      DateTime
  startTime String
  endTime   String
  isBooked  Boolean  @default(false)
  price     Int      @default(500)
  createdAt DateTime @default(now())

  booking Booking?

  @@index([turfId, date])
  @@map("slot_availabilities")
}

model BlockedDate {
  id        String   @id @default(uuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@unique([venueId, date])
  @@map("blocked_dates")
}

model PricingOverride {
  id        String   @id @default(uuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  date      DateTime
  price     Int
  reason    String?
  createdAt DateTime @default(now())

  @@unique([venueId, date])
  @@map("pricing_overrides")
}

model Booking {
  id                  String            @id @default(uuid())
  bookingNumber       String            @unique
  userId              String?
  user                User?             @relation(fields: [userId], references: [id])
  turfId              String
  turf                Turf              @relation(fields: [turfId], references: [id])
  slotId              String?           @unique
  slot                SlotAvailability? @relation(fields: [slotId], references: [id])
  date                DateTime
  startTime           String
  endTime             String
  duration            Int               @default(60) // minutes
  numPlayers          Int               @default(10)
  totalAmount         Int               @default(0)
  discountAmount      Int               @default(0)
  couponCode          String?
  customerName        String?
  customerPhone       String?
  customerEmail       String?
  startAt             DateTime?
  endAt               DateTime?
  quoteSnapshot       Json?
  idempotencyKey      String?           @unique
  guestTokenHash      String?           @unique
  guestTokenExpiresAt DateTime?
  status              BookingStatus     @default(PENDING)
  blocksAvailability  Boolean           @default(true)
  notes               String?
  qrCodeData          String?
  cancellationReason  String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?
  deletedById         String?
  deleteReason        String?

  payments          Payment[]
  bookingServices   BookingService[]
  reviews           Review[]
  ledgerEntries     PaymentLedgerEntry[]
  couponRedemptions CouponRedemption[]

  @@index([userId])
  @@index([turfId])
  @@index([turfId, date, status])
  @@index([date])
  @@index([status])
  @@index([deletedAt])
  @@index([turfId, startAt, endAt])
  @@map("bookings")
}

model BookingService {
  id                  String            @id @default(uuid())
  bookingId           String
  booking             Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  additionalServiceId String
  additionalService   AdditionalService @relation(fields: [additionalServiceId], references: [id])
  quantity            Int               @default(1)
  price               Int               @default(0)

  @@map("booking_services")
}

model Payment {
  id              String        @id @default(uuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  amount          Int           @default(0)
  currency        String        @default("INR")
  status          PaymentStatus @default(PENDING)
  method          String? // card, upi, netbanking, wallet
  transactionId   String?
  stripePaymentId String?
  refundAmount    Int           @default(0)
  refundReason    String?
  capturedAt      DateTime?
  refundedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  ledgerEntries PaymentLedgerEntry[]

  @@index([bookingId])
  @@index([userId])
  @@map("payments")
}

// Immutable accounting entries are the source for revenue and refund totals.
// The legacy Payment status/amount columns remain as a v1 compatibility view.
model PaymentLedgerEntry {
  id             String          @id @default(uuid())
  bookingId      String
  booking        Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  paymentId      String?
  payment        Payment?        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  type           LedgerEntryType
  amount         Int
  currency       String          @default("INR")
  idempotencyKey String          @unique
  metadata       Json?
  createdById    String?
  createdAt      DateTime        @default(now())

  @@index([bookingId, createdAt])
  @@index([type, createdAt])
  @@map("payment_ledger_entries")
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  discountType  String // PERCENTAGE, FIXED
  discountValue Int
  maxUses       Int?
  usedCount     Int       @default(0)
  minAmount     Int?
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  deletedById   String?
  deleteReason  String?

  redemptions CouponRedemption[]

  @@index([deletedAt])
  @@map("coupons")
}

model CouponRedemption {
  id             String    @id @default(uuid())
  couponId       String
  coupon         Coupon    @relation(fields: [couponId], references: [id], onDelete: Restrict)
  bookingId      String
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  discountAmount Int
  releasedAt     DateTime?
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())

  @@unique([couponId, bookingId])
  @@index([couponId, releasedAt])
  @@map("coupon_redemptions")
}

model Review {
  id           String    @id @default(uuid())
  bookingId    String?
  booking      Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  venueId      String
  venue        Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  rating       Int       @default(5)
  comment      String?
  isApproved   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  @@unique([userId, venueId])
  @@index([deletedAt])
  @@map("reviews")
}

model VenueGallery {
  id        String   @id @default(uuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  imageUrl  String
  caption   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("venue_gallery")
}

// ──────────────────────────────────────────────────────────────
// FUSION LEAGUE
// ──────────────────────────────────────────────────────────────

model Season {
  id                     String    @id @default(uuid())
  name                   String
  slug                   String    @unique
  startDate              DateTime
  endDate                DateTime
  isActive               Boolean   @default(false)
  isCurrent              Boolean   @default(false)
  description            String?
  // 10 = 2 * (6 teams - 1): the number of weeks a full home-and-away
  // round-robin actually needs for the default 6-team format. The previous
  // default of 7 was too short by 3 rounds and silently produced an
  // incomplete schedule — see the leagueWeeks check in generateSeasonFixtures.
  leagueWeeks            Int       @default(10)
  fixtureDays            String    @default("Friday,Saturday,Sunday")
  transferWindowOpen     Boolean   @default(false)
  transferWindowStartsAt DateTime?
  transferWindowEndsAt   DateTime?
  managedById            String?
  managedBy              User?     @relation("ManagedSeasons", fields: [managedById], references: [id])
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?
  deletedById            String?
  deleteReason           String?

  teams               Team[]
  players             Player[]
  fixtures            Fixture[]
  standings           Standing[]
  standingAdjustments StandingAdjustment[]
  suspensions         Suspension[]
  awards              Award[]
  competitions        Competition[]
  previousWinners     PreviousWinner[]
  playerStats         PlayerStat[]
  friendlyPlayerStats FriendlyPlayerStat[]
  news                News[]
  galleries           Gallery[]
  transfersFromSeason PlayerTransfer[]         @relation("TransfersFromSeason")
  transfersToSeason   PlayerTransfer[]         @relation("TransfersToSeason")
  seasonClubs         SeasonClub[]
  registrations       PlayerRegistration[]
  schedulePreviews    FixtureGenerationBatch[]

  @@index([deletedAt])
  @@map("seasons")
}

model Competition {
  id            String             @id @default(uuid())
  seasonId      String
  season        Season             @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  name          String
  slug          String
  type          FixtureCompetition @default(LEAGUE)
  isActive      Boolean            @default(true)
  timezone      String             @default("Asia/Kolkata")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  bracketSize   Int?
  bracketStatus String             @default("NOT_STARTED")
  deletedAt     DateTime?
  deletedById   String?
  deleteReason  String?

  fixtures           Fixture[]
  bracketMatches     BracketMatch[]
  entries            CompetitionEntry[]
  ruleSets           CompetitionRuleSet[]
  registrations      PlayerRegistration[]
  projectionVersions ProjectionVersion[]
  schedulePreviews   FixtureGenerationBatch[]
  suspensions        Suspension[]

  @@unique([seasonId, slug])
  @@index([deletedAt])
  @@map("competitions")
}

// Permanent club identity. Team remains the v1 season-scoped representation
// until every controller has moved to SeasonClub/CompetitionEntry.
model Club {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  shortName    String?
  logoUrl      String?
  coverUrl     String?
  city         String?
  foundedYear  Int?
  homeStadium  String?
  description  String?
  history      String?
  achievements Json?
  website      String?
  socialLinks  Json?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  seasonClubs         SeasonClub[]
  competitionEntries  CompetitionEntry[]
  teams               Team[]
  playerRegistrations PlayerRegistration[]
  staffRegistrations  StaffRegistration[]

  @@index([deletedAt])
  @@map("clubs")
}

model SeasonClub {
  id           String             @id @default(uuid())
  seasonId     String
  season       Season             @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  clubId       String
  club         Club               @relation(fields: [clubId], references: [id], onDelete: Restrict)
  teamId       String?            @unique
  team         Team?              @relation(fields: [teamId], references: [id], onDelete: Restrict)
  status       RegistrationStatus @default(ACTIVE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  @@unique([seasonId, clubId])
  @@index([deletedAt])
  @@map("season_clubs")
}

model CompetitionEntry {
  id            String             @id @default(uuid())
  competitionId String
  competition   Competition        @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  clubId        String
  club          Club               @relation(fields: [clubId], references: [id], onDelete: Restrict)
  teamId        String?
  team          Team?              @relation(fields: [teamId], references: [id], onDelete: Restrict)
  seed          Int?
  status        RegistrationStatus @default(ACTIVE)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?
  deletedById   String?
  deleteReason  String?

  homeFixtures Fixture[] @relation("HomeCompetitionEntry")
  awayFixtures Fixture[] @relation("AwayCompetitionEntry")

  @@unique([competitionId, clubId])
  @@unique([competitionId, teamId])
  @@index([deletedAt])
  @@map("competition_entries")
}

model CompetitionRuleSet {
  id                      String      @id @default(uuid())
  competitionId           String
  competition             Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  version                 Int
  isActive                Boolean     @default(false)
  format                  String      @default("ROUND_ROBIN")
  legs                    Int         @default(2)
  teamSize                Int         @default(6)
  starterLimit            Int         @default(6)
  substituteLimit         Int         @default(2)
  substitutionLimit       Int         @default(2)
  matchDurationMinutes    Int         @default(60)
  extraTimeEnabled        Boolean     @default(false)
  extraTimeMinutes        Int         @default(30)
  penaltiesEnabled        Boolean     @default(true)
  pointsForWin            Int         @default(3)
  pointsForDraw           Int         @default(1)
  pointsForLoss           Int         @default(0)
  tieBreakers             Json        @default("[\"HEAD_TO_HEAD_POINTS\",\"HEAD_TO_HEAD_GOAL_DIFFERENCE\",\"GOAL_DIFFERENCE\",\"GOALS_FOR\",\"TEAM_NAME\"]")
  yellowCardThreshold     Int         @default(2)
  yellowSuspensionMatches Int         @default(1)
  suspensionScope         String      @default("COMPETITION")
  minimumRestHours        Int         @default(24)
  postseasonRules         Json        @default("{}")
  createdById             String?
  createdAt               DateTime    @default(now())

  @@unique([competitionId, version])
  @@index([competitionId, isActive])
  @@map("competition_rule_sets")
}

model Team {
  id           String    @id @default(uuid())
  seasonId     String
  season       Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  clubId       String?
  club         Club?     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  name         String
  slug         String
  shortName    String?
  logoUrl      String?
  coverUrl     String?
  city         String?
  foundedYear  Int?
  homeStadium  String?
  description  String?
  history      String?
  achievements Json?
  website      String?
  socialLinks  Json?
  status       String    @default("active")
  isActive     Boolean   @default(true)
  managedById  String?
  managedBy    User?     @relation("ManagedTeams", fields: [managedById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  homeMatches           Fixture[]            @relation("HomeTeam")
  awayMatches           Fixture[]            @relation("AwayTeam")
  players               Player[]
  staff                 Staff[]
  standings             Standing[]
  standingAdjustments   StandingAdjustment[]
  teamStats             TeamStat[]
  galleries             Gallery[]
  sponsors              Sponsor[]
  news                  News[]
  homePlayerStats       PlayerStat[]         @relation("homePlayerStats")
  friendlyStats         FriendlyPlayerStat[]
  lineups               Lineup[]
  matchdaySquads        MatchdaySquad[]
  awardWins             Award[]              @relation("TeamAwardWins")
  previousWinnerEntries PreviousWinner[]     @relation("TeamPreviousWinners")
  followers             UserFollow[]
  bracketHomeMatches    BracketMatch[]       @relation("BracketHomeTeam")
  bracketAwayMatches    BracketMatch[]       @relation("BracketAwayTeam")
  bracketWins           BracketMatch[]       @relation("BracketWinner")
  transfersFrom         PlayerTransfer[]     @relation("TransfersFrom")
  transfersTo           PlayerTransfer[]     @relation("TransfersTo")
  seasonClub            SeasonClub?
  competitionEntries    CompetitionEntry[]
  playerRegistrations   PlayerRegistration[]

  @@unique([seasonId, slug])
  @@index([clubId])
  @@index([deletedAt])
  @@map("teams")
}

// Permanent person identity. The legacy Player model remains a season record
// and links here during the compatibility release.
model PlayerProfile {
  id            String    @id @default(uuid())
  slug          String    @unique
  firstName     String
  lastName      String
  nationality   String?
  dateOfBirth   DateTime?
  height        Int?
  weight        Int?
  preferredFoot String?
  photoUrl      String?
  biography     String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  deletedById   String?
  deleteReason  String?

  legacyPlayers Player[]
  registrations PlayerRegistration[]

  @@index([deletedAt])
  @@map("player_profiles")
}

model PlayerRegistration {
  id              String             @id @default(uuid())
  playerProfileId String
  playerProfile   PlayerProfile      @relation(fields: [playerProfileId], references: [id], onDelete: Restrict)
  seasonId        String
  season          Season             @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  competitionId   String?
  competition     Competition?       @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  clubId          String
  club            Club               @relation(fields: [clubId], references: [id], onDelete: Restrict)
  teamId          String?
  team            Team?              @relation(fields: [teamId], references: [id], onDelete: Restrict)
  validFrom       DateTime
  validTo         DateTime?
  jerseyNumber    Int?
  position        String?
  status          RegistrationStatus @default(ACTIVE)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  deletedById     String?
  deleteReason    String?

  @@unique([playerProfileId, seasonId, validFrom])
  @@index([clubId, validFrom, validTo])
  @@index([competitionId, status])
  @@index([deletedAt])
  @@map("player_registrations")
}

model StaffProfile {
  id           String    @id @default(uuid())
  slug         String    @unique
  firstName    String
  lastName     String
  photoUrl     String?
  biography    String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  legacyStaff   Staff[]
  registrations StaffRegistration[]

  @@index([deletedAt])
  @@map("staff_profiles")
}

model StaffRegistration {
  id             String             @id @default(uuid())
  staffProfileId String
  staffProfile   StaffProfile       @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)
  clubId         String
  club           Club               @relation(fields: [clubId], references: [id], onDelete: Restrict)
  teamId         String?
  validFrom      DateTime
  validTo        DateTime?
  role           String
  status         RegistrationStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?
  deletedById    String?
  deleteReason   String?

  @@index([clubId, validFrom, validTo])
  @@index([deletedAt])
  @@map("staff_registrations")
}

model Player {
  id            String         @id @default(uuid())
  seasonId      String
  season        Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  profileId     String?
  profile       PlayerProfile? @relation(fields: [profileId], references: [id], onDelete: Restrict)
  teamId        String?
  team          Team?          @relation(fields: [teamId], references: [id])
  firstName     String
  lastName      String
  slug          String
  nationality   String?
  dateOfBirth   DateTime?
  age           Int?
  height        Int? // cm
  weight        Int? // kg
  preferredFoot String? // Left, Right, Both
  jerseyNumber  Int?
  position      String? // GK, CB, LB, RB, CM, CAM, CDM, LM, RM, LW, RW, ST, CF
  photoUrl      String?
  biography     String?
  squadType     SquadType? // STARTER, SUBSTITUTE, RESERVE
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  deletedById   String?
  deleteReason  String?

  homeStats          PlayerStat[]
  goals              Goal[]
  assists            Assist[]
  cards              Card[]
  suspensions        Suspension[]
  subsOff            Substitution[]       @relation("PlayerOff")
  subsOn             Substitution[]       @relation("PlayerOn")
  matchNotes         MatchNote[]
  previousWinners    PreviousWinner[]
  matchPlayerRatings MatchPlayerRating[]
  lineups            Lineup[]
  squadSelections    MatchdaySquadEntry[]
  awardsWon          Award[]
  awardNominations   AwardNomination[]
  votesReceived      Vote[]
  manOfTheMatch      Fixture[]
  galleries          Gallery[]
  followers          UserFollow[]
  pollOptions        PollOption[]
  friendlyStats      FriendlyPlayerStat[]
  matchAppearances   MatchAppearance[]
  matchShots         MatchShot[]
  transfers          PlayerTransfer[]

  @@unique([seasonId, slug])
  @@index([teamId])
  @@index([profileId])
  @@index([deletedAt])
  @@map("players")
}

model Staff {
  id           String        @id @default(uuid())
  teamId       String
  team         Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  profileId    String?
  profile      StaffProfile? @relation(fields: [profileId], references: [id], onDelete: Restrict)
  firstName    String
  lastName     String
  role         String // Coach, Assistant Coach, Physio, Manager, etc.
  photoUrl     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  @@index([profileId])
  @@index([deletedAt])
  @@map("staff")
}

// ──────────────────────────────────────────────────────────────
// FIXTURES & MATCHES
// ──────────────────────────────────────────────────────────────

model Fixture {
  id                     String                  @id @default(uuid())
  seasonId               String
  season                 Season                  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  competitionId          String?
  competition            Competition?            @relation(fields: [competitionId], references: [id])
  homeEntryId            String?
  homeEntry              CompetitionEntry?       @relation("HomeCompetitionEntry", fields: [homeEntryId], references: [id], onDelete: Restrict)
  awayEntryId            String?
  awayEntry              CompetitionEntry?       @relation("AwayCompetitionEntry", fields: [awayEntryId], references: [id], onDelete: Restrict)
  homeTeamId             String
  homeTeam               Team                    @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId             String
  awayTeam               Team                    @relation("AwayTeam", fields: [awayTeamId], references: [id])
  venueId                String?
  venue                  Venue?                  @relation(fields: [venueId], references: [id])
  matchDate              DateTime
  scheduledDate          String?
  kickoffTime            String?
  kickoffAt              DateTime?
  round                  Int?
  leagueWeek             Int?
  isGrandFinal           Boolean                 @default(false)
  isRelegationPlayoff    Boolean                 @default(false)
  isFriendly             Boolean                 @default(false)
  status                 MatchStatus             @default(SCHEDULED)
  version                Int                     @default(0)
  resultSourceVersion    Int                     @default(0)
  finalizedAt            DateTime?
  matchClockSeconds      Int                     @default(0)
  matchClockStartedAt    DateTime?
  homeScore              Int?
  awayScore              Int?
  homePossession         Int? // percentage
  awayPossession         Int?
  homeShots              Int?
  awayShots              Int?
  homeShotsOnTarget      Int?
  awayShotsOnTarget      Int?
  homeCorners            Int?
  awayCorners            Int?
  homeFouls              Int?
  awayFouls              Int?
  homeOffsides           Int?
  awayOffsides           Int?
  homeExpectedGoals      Float?
  awayExpectedGoals      Float?
  referee                String?
  referee2               String?
  refereeAssignedAt      DateTime?
  originalMatchDate      DateTime?
  postponementReason     String?
  rescheduleReason       String?
  rescheduledAt          DateTime?
  extraTimeHomeScore     Int?
  extraTimeAwayScore     Int?
  penaltiesHomeScore     Int?
  penaltiesAwayScore     Int?
  winnerTeamId           String?
  outcome                String                  @default("REGULAR") // REGULAR, WALKOVER, FORFEIT
  attendance             Int?
  stadium                String?
  matchReport            String?
  highlights             String?
  manOfTheMatchId        String?
  manOfTheMatch          Player?                 @relation(fields: [manOfTheMatchId], references: [id])
  isFeatured             Boolean                 @default(false)
  // Tracks whether serveSuspension()/processSuspensions() have successfully
  // run for this fixture, independent of `status`. Gating that step on
  // `status === COMPLETED` alone meant a partial-failure retry (e.g. the
  // pipeline throws after the fixture is already marked COMPLETED) would
  // silently skip suspension processing forever, since status would no
  // longer look "newly completed" on retry.
  suspensionsProcessedAt DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  deletedById            String?
  deleteReason           String?
  generationBatchId      String?
  generationBatch        FixtureGenerationBatch? @relation(fields: [generationBatchId], references: [id], onDelete: SetNull)

  goals              Goal[]
  assists            Assist[]
  cards              Card[]
  substitutions      Substitution[]
  notes              MatchNote[]
  lineups            Lineup[]
  matchPlayerRatings MatchPlayerRating[]
  comments           MatchComment[]
  matchdaySquads     MatchdaySquad[]
  appearances        MatchAppearance[]
  galleries          Gallery[]
  rsvps              MatchRsvp[]
  polls              Poll[]
  resultRevisions    MatchResultRevision[]
  eventStream        MatchEvent[]
  shots              MatchShot[]
  bracketMatch       BracketMatch?

  @@index([seasonId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([matchDate])
  @@index([status])
  @@index([deletedAt])
  @@index([scheduledDate, kickoffAt, id])
  @@index([generationBatchId])
  @@index([homeEntryId])
  @@index([awayEntryId])
  @@map("fixtures")
}

model FixtureGenerationBatch {
  id            String                @id @default(uuid())
  seasonId      String
  season        Season                @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  competitionId String
  competition   Competition           @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  status        SchedulePreviewStatus @default(DRAFT)
  input         Json
  diff          Json
  requestedById String?
  expiresAt     DateTime?
  publishedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  fixtures Fixture[]

  @@index([competitionId, status, createdAt])
  @@map("fixture_generation_batches")
}

model BracketMatch {
  id            String      @id @default(uuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  roundNumber   Int
  position      Int
  fixtureId     String?     @unique
  fixture       Fixture?    @relation(fields: [fixtureId], references: [id], onDelete: SetNull)
  homeTeamId    String?
  homeTeam      Team?       @relation("BracketHomeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeamId    String?
  awayTeam      Team?       @relation("BracketAwayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull)
  winnerTeamId  String?
  winnerTeam    Team?       @relation("BracketWinner", fields: [winnerTeamId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([competitionId, roundNumber, position])
  @@index([competitionId, roundNumber])
  @@map("bracket_matches")
}

model PlayerTransfer {
  id            String   @id @default(uuid())
  playerId      String
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  fromTeamId    String?
  fromTeam      Team?    @relation("TransfersFrom", fields: [fromTeamId], references: [id], onDelete: SetNull)
  toTeamId      String?
  toTeam        Team?    @relation("TransfersTo", fields: [toTeamId], references: [id], onDelete: SetNull)
  fromSeasonId  String?
  fromSeason    Season?  @relation("TransfersFromSeason", fields: [fromSeasonId], references: [id], onDelete: SetNull)
  toSeasonId    String?
  toSeason      Season?  @relation("TransfersToSeason", fields: [toSeasonId], references: [id], onDelete: SetNull)
  reason        String?
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  transferredAt DateTime @default(now())

  @@index([playerId, transferredAt])
  @@map("player_transfers")
}

model MatchResultRevision {
  id                String   @id @default(uuid())
  fixtureId         String
  fixture           Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  changedById       String?
  changedBy         User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)
  previousHomeScore Int?
  previousAwayScore Int?
  nextHomeScore     Int
  nextAwayScore     Int
  reason            String?
  sourceVersion     Int      @default(0)
  idempotencyKey    String?  @unique
  createdAt         DateTime @default(now())

  @@index([fixtureId, createdAt])
  @@map("match_result_revisions")
}

// Append-only authority for v2 match activity. Corrections are represented by
// CORRECTION/REVERSAL rows; deployed database triggers reject UPDATE/DELETE.
model MatchEvent {
  id                               String         @id @default(uuid())
  fixtureId                        String
  fixture                          Fixture        @relation(fields: [fixtureId], references: [id], onDelete: Restrict)
  sequence                         Int
  type                             MatchEventType
  minute                           Int?
  second                           Int?
  teamIdSnapshot                   String?
  playerProfileIdSnapshot          String?
  playerRegistrationIdSnapshot     String?
  secondaryPlayerProfileIdSnapshot String?
  payload                          Json?
  reversalOfId                     String?        @unique
  reversalOf                       MatchEvent?    @relation("MatchEventReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy                       MatchEvent?    @relation("MatchEventReversal")
  idempotencyKey                   String         @unique
  createdById                      String?
  createdAt                        DateTime       @default(now())

  @@unique([fixtureId, sequence])
  @@index([fixtureId, createdAt])
  @@map("match_events")
}

model ProjectionVersion {
  id            String      @id @default(uuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  projection    String
  sourceVersion Int         @default(0)
  status        String      @default("PENDING")
  lastBuiltAt   DateTime?
  lastError     String?
  updatedAt     DateTime    @updatedAt

  @@unique([competitionId, projection])
  @@index([status, updatedAt])
  @@map("projection_versions")
}

model OutboxEvent {
  id             String       @id @default(uuid())
  aggregateType  String
  aggregateId    String
  eventType      String
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  availableAt    DateTime     @default(now())
  processedAt    DateTime?
  lastError      String?
  idempotencyKey String       @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model CommandReceipt {
  id          String    @id @default(uuid())
  scope       String
  key         String
  requestHash String
  response    Json?
  statusCode  Int?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("command_receipts")
}

model ArchiveRecord {
  id           String    @id @default(uuid())
  resourceType String
  resourceId   String
  displayName  String
  deleteReason String?
  deletedById  String?
  metadata     Json?
  deletedAt    DateTime  @default(now())
  restoredById String?
  restoredAt   DateTime?

  @@index([restoredAt, deletedAt])
  @@index([resourceType, restoredAt])
  @@index([resourceType, resourceId])
  @@map("archive_records")
}

model IdentityReconciliationIssue {
  id           String    @id @default(uuid())
  entityType   String
  matchKey     String
  sourceIds    Json
  reason       String
  status       String    @default("OPEN")
  resolution   Json?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([entityType, matchKey])
  @@index([status, entityType])
  @@map("identity_reconciliation_issues")
}

model Goal {
  id        String   @id @default(uuid())
  fixtureId String
  fixture   Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id])
  // Snapshot of the club credited at the time of the event. Players can move
  // during a season, so Player.teamId is not safe historical data.
  teamId    String?
  minute    Int
  isOwnGoal Boolean  @default(false)
  isPenalty Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([fixtureId, teamId])
  @@index([fixtureId])
  @@index([playerId])
  @@map("goals")
}

model Assist {
  id        String   @id @default(uuid())
  fixtureId String
  fixture   Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id])
  teamId    String?
  goalId    String?
  minute    Int
  createdAt DateTime @default(now())

  @@index([fixtureId, teamId])
  @@index([fixtureId])
  @@index([playerId])
  @@map("assists")
}

model Card {
  id        String   @id @default(uuid())
  fixtureId String
  fixture   Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id])
  teamId    String?
  type      String // YELLOW, RED, SECOND_YELLOW
  minute    Int
  reason    String?
  createdAt DateTime @default(now())

  @@index([fixtureId, teamId])
  @@index([fixtureId])
  @@index([playerId, type])
  @@map("cards")
}

model Substitution {
  id          String   @id @default(uuid())
  fixtureId   String
  fixture     Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  playerOffId String
  playerOff   Player   @relation("PlayerOff", fields: [playerOffId], references: [id])
  playerOnId  String
  playerOn    Player   @relation("PlayerOn", fields: [playerOnId], references: [id])
  minute      Int
  teamId      String?
  createdAt   DateTime @default(now())

  @@index([fixtureId, teamId])
  @@index([fixtureId])
  @@map("substitutions")
}

model MatchNote {
  id        String   @id @default(uuid())
  fixtureId String
  fixture   Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  teamId    String?
  playerId  String?
  player    Player?  @relation(fields: [playerId], references: [id])
  type      String // VAR, MISSED_PENALTY, INFO
  minute    Int
  note      String?
  createdAt DateTime @default(now())

  @@index([fixtureId])
  @@map("match_notes")
}

model Lineup {
  id           String   @id @default(uuid())
  fixtureId    String
  fixture      Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id])
  playerId     String
  player       Player   @relation(fields: [playerId], references: [id])
  isStarter    Boolean  @default(true)
  position     String?
  jerseyNumber Int?
  // Field role the player occupies in this fixture (e.g. "GK", "CB", "ST").
  role         String?
  // Normalised pitch coordinates (0-100). x = left-right, y = top-bottom.
  xPosition    Float    @default(50)
  yPosition    Float    @default(50)
  isCaptain    Boolean  @default(false)
  isGoalkeeper Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([fixtureId, playerId])
  @@index([fixtureId])
  @@index([teamId])
  @@map("lineups")
}

// A player appears when listed in a lineup or when brought on. It captures
// their club for that fixture, preventing transfers from rewriting history.
model MatchAppearance {
  id        String   @id @default(uuid())
  fixtureId String
  fixture   Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamId    String
  isStarter Boolean  @default(false)
  enteredAt Int?
  createdAt DateTime @default(now())

  @@unique([fixtureId, playerId])
  @@index([playerId, teamId])
  @@map("match_appearances")
}

model MatchShot {
  id        String      @id @default(uuid())
  fixtureId String
  fixture   Fixture     @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamId    String
  outcome   ShotOutcome
  minute    Int?
  createdAt DateTime    @default(now())

  @@index([fixtureId, outcome])
  @@index([playerId, teamId])
  @@map("match_shots")
}

model MatchPlayerRating {
  id            String   @id @default(uuid())
  fixtureId     String
  fixture       Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  playerId      String
  player        Player   @relation(fields: [playerId], references: [id])
  rating        Float    @default(0.0)
  minutesPlayed Int?
  createdAt     DateTime @default(now())

  @@unique([fixtureId, playerId])
  @@map("match_player_ratings")
}

model MatchComment {
  id        String   @id @default(uuid())
  fixtureId String
  fixture   Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@map("match_comments")
}

model MatchdaySquad {
  id        String   @id @default(uuid())
  fixtureId String
  fixture   Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  createdAt DateTime @default(now())

  entries MatchdaySquadEntry[]

  @@unique([fixtureId, teamId])
  @@map("matchday_squads")
}

model MatchdaySquadEntry {
  id           String        @id @default(uuid())
  squadId      String
  squad        MatchdaySquad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  playerId     String
  player       Player        @relation(fields: [playerId], references: [id])
  isStarter    Boolean       @default(true)
  jerseyNumber Int?
  createdAt    DateTime      @default(now())

  @@unique([squadId, playerId])
  @@map("matchday_squad_entries")
}

model Suspension {
  id               String           @id @default(uuid())
  seasonId         String
  season           Season           @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  playerId         String
  player           Player           @relation(fields: [playerId], references: [id])
  competitionId    String?
  competition      Competition?     @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  milestone        Int?
  reason           SuspensionReason
  matchBan         Int              @default(1)
  startDate        DateTime         @default(now())
  endDate          DateTime?
  served           Int              @default(0)
  isActive         Boolean          @default(true)
  notes            String?
  createdAt        DateTime         @default(now())
  deletedAt        DateTime?
  deletedById      String?
  deleteReason     String?
  servedFixtureIds Json             @default("[]")

  @@index([seasonId, playerId])
  @@index([competitionId, playerId, isActive])
  @@index([deletedAt])
  @@map("suspensions")
}

// ──────────────────────────────────────────────────────────────
// STANDINGS & STATISTICS
// ──────────────────────────────────────────────────────────────

model Standing {
  id             String   @id @default(uuid())
  seasonId       String
  season         Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  teamId         String
  team           Team     @relation(fields: [teamId], references: [id])
  position       Int      @default(0)
  played         Int      @default(0)
  wins           Int      @default(0)
  draws          Int      @default(0)
  losses         Int      @default(0)
  goalsFor       Int      @default(0)
  goalsAgainst   Int      @default(0)
  goalDifference Int      @default(0)
  points         Int      @default(0)
  form           String? // "WWDLW" format
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([seasonId, teamId])
  @@index([seasonId, position])
  @@map("standings")
}

model StandingAdjustment {
  id                String    @id @default(uuid())
  seasonId          String
  season            Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  teamId            String
  team              Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  pointsDelta       Int       @default(0)
  goalsForDelta     Int       @default(0)
  goalsAgainstDelta Int       @default(0)
  reason            String
  createdById       String?
  createdAt         DateTime  @default(now())
  deletedAt         DateTime?
  deletedById       String?
  deleteReason      String?

  @@index([seasonId, teamId])
  @@index([deletedAt])
  @@map("standing_adjustments")
}

model PlayerStat {
  id              String   @id @default(uuid())
  seasonId        String
  season          Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  playerId        String
  player          Player   @relation(fields: [playerId], references: [id])
  teamId          String
  team            Team     @relation("homePlayerStats", fields: [teamId], references: [id])
  appearances     Int      @default(0)
  goals           Int      @default(0)
  assists         Int      @default(0)
  minutesPlayed   Int      @default(0)
  passAccuracy    Float?
  shots           Int      @default(0)
  shotsOnTarget   Int      @default(0)
  tackles         Int      @default(0)
  interceptions   Int      @default(0)
  fouls           Int      @default(0)
  offsides        Int      @default(0)
  yellowCards     Int      @default(0)
  redCards        Int      @default(0)
  saves           Int?     @default(0)
  cleanSheets     Int?     @default(0)
  goalsConceded   Int?     @default(0)
  averageRating   Float?
  distanceCovered Float?
  passes          Int?
  keyPasses       Int?
  dribbles        Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([seasonId, playerId, teamId])
  @@map("player_stats")
}

model FriendlyPlayerStat {
  id            String   @id @default(uuid())
  seasonId      String
  season        Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  playerId      String
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamId        String
  team          Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  appearances   Int      @default(0)
  goals         Int      @default(0)
  assists       Int      @default(0)
  minutesPlayed Int      @default(0)
  shots         Int      @default(0)
  shotsOnTarget Int      @default(0)
  yellowCards   Int      @default(0)
  redCards      Int      @default(0)
  averageRating Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([seasonId, playerId, teamId])
  @@map("friendly_player_stats")
}

model TeamStat {
  id            String   @id @default(uuid())
  seasonId      String
  teamId        String
  team          Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  totalGoals    Int      @default(0)
  totalAssists  Int      @default(0)
  totalShots    Int      @default(0)
  totalCorners  Int      @default(0)
  totalFouls    Int      @default(0)
  totalOffsides Int      @default(0)
  avgPossession Float?
  cleanSheets   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([seasonId, teamId])
  @@map("team_stats")
}

// ──────────────────────────────────────────────────────────────
// AWARDS & VOTING
// ──────────────────────────────────────────────────────────────

model Award {
  id                       String          @id @default(uuid())
  seasonId                 String
  season                   Season          @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  name                     String
  slug                     String
  description              String?
  trophyImageUrl           String?
  rules                    String?
  eligibilityCriteria      String?
  managedById              String?
  managedBy                User?           @relation("ManagedAwards", fields: [managedById], references: [id])
  votingEnabled            Boolean         @default(false)
  votingType               AwardVotingType @default(REGISTERED_ONLY)
  voteFrequency            VoteFrequency   @default(ONCE)
  allowAnonymous           Boolean         @default(false)
  requireOTP               Boolean         @default(false)
  requireEmailVerification Boolean         @default(false)
  requireCaptcha           Boolean         @default(false)
  ipProtection             Boolean         @default(true)
  deviceFingerprint        Boolean         @default(false)
  voteModeration           Boolean         @default(false)
  manualApproval           Boolean         @default(false)
  hiddenVoteMode           Boolean         @default(false)
  hideResultsUntil         DateTime?
  votingStartDate          DateTime?
  votingEndDate            DateTime?
  autoCloseVoting          Boolean         @default(true)
  autoAnnounceWinner       Boolean         @default(false)
  winnerAnnounced          Boolean         @default(false)
  winnerId                 String?
  winner                   Player?         @relation(fields: [winnerId], references: [id])
  isActive                 Boolean         @default(true)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  deletedAt                DateTime?
  deletedById              String?
  deleteReason             String?
  type                     String          @default("PLAYER")
  winnerTeamId             String?
  winnerTeam               Team?           @relation("TeamAwardWins", fields: [winnerTeamId], references: [id])

  nominations     AwardNomination[]
  votes           Vote[]
  previousWinners PreviousWinner[]
  galleries       Gallery[]

  @@unique([seasonId, slug])
  @@index([winnerTeamId])
  @@index([deletedAt])
  @@map("awards")
}

model AwardNomination {
  id        String   @id @default(uuid())
  awardId   String
  award     Award    @relation(fields: [awardId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id])
  reason    String?
  createdAt DateTime @default(now())

  @@unique([awardId, playerId])
  @@map("award_nominations")
}

model Vote {
  id                String     @id @default(uuid())
  awardId           String
  award             Award      @relation(fields: [awardId], references: [id], onDelete: Cascade)
  nomineeId         String
  nominee           Player     @relation(fields: [nomineeId], references: [id])
  userId            String?
  user              User?      @relation(fields: [userId], references: [id])
  ipAddress         String?
  deviceFingerprint String?
  isAnonymous       Boolean    @default(false)
  status            VoteStatus @default(APPROVED)
  createdAt         DateTime   @default(now())

  @@index([awardId])
  @@index([userId])
  @@map("votes")
}

model PreviousWinner {
  id        String   @id @default(uuid())
  awardId   String
  award     Award    @relation(fields: [awardId], references: [id], onDelete: Cascade)
  playerId  String?
  player    Player?  @relation(fields: [playerId], references: [id])
  teamId    String?
  team      Team?    @relation("TeamPreviousWinners", fields: [teamId], references: [id])
  seasonId  String
  season    Season   @relation(fields: [seasonId], references: [id])
  year      String
  createdAt DateTime @default(now())

  @@map("previous_winners")
}

// ──────────────────────────────────────────────────────────────
// CMS
// ──────────────────────────────────────────────────────────────

model News {
  id           String    @id @default(uuid())
  seasonId     String?
  season       Season?   @relation(fields: [seasonId], references: [id])
  teamId       String?
  team         Team?     @relation(fields: [teamId], references: [id])
  title        String
  slug         String    @unique
  excerpt      String?
  content      String?
  imageUrl     String?
  author       String?
  isFeatured   Boolean   @default(false)
  isPublished  Boolean   @default(true)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  @@index([seasonId])
  @@index([teamId])
  @@index([isFeatured])
  @@index([deletedAt])
  @@map("news")
}

model Gallery {
  id           String    @id @default(uuid())
  seasonId     String?
  season       Season?   @relation(fields: [seasonId], references: [id])
  teamId       String?
  team         Team?     @relation(fields: [teamId], references: [id])
  playerId     String?
  player       Player?   @relation(fields: [playerId], references: [id])
  fixtureId    String?
  fixture      Fixture?  @relation(fields: [fixtureId], references: [id])
  awardId      String?
  award        Award?    @relation(fields: [awardId], references: [id])
  title        String
  imageUrl     String
  videoUrl     String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  @@index([deletedAt])
  @@map("galleries")
}

model Sponsor {
  id           String    @id @default(uuid())
  teamId       String?
  team         Team?     @relation(fields: [teamId], references: [id])
  name         String
  logoUrl      String
  website      String?
  tier         String? // Platinum, Gold, Silver
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  @@index([deletedAt])
  @@map("sponsors")
}

model Advertisement {
  id           String    @id @default(uuid())
  title        String
  imageUrl     String
  linkUrl      String?
  position     String? // hero, sidebar, banner
  isActive     Boolean   @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  @@index([deletedAt])
  @@map("advertisements")
}

model Faq {
  id           String    @id @default(uuid())
  question     String
  answer       String
  category     String? // booking, league, general
  order        Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  @@index([deletedAt])
  @@map("faqs")
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
  group String @default("general")

  @@map("settings")
}

// ──────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ──────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String // booking, match, award, system, promotion
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  sentById  String?
  sentBy    User?    @relation("SentNotifications", fields: [sentById], references: [id])
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

enum FollowType {
  TEAM
  PLAYER
}

model UserFollow {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      FollowType
  teamId    String?
  team      Team?      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId  String?
  player    Player?    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  notify    Boolean    @default(true)
  createdAt DateTime   @default(now())

  @@unique([userId, teamId])
  @@unique([userId, playerId])
  @@index([userId, type])
  @@map("user_follows")
}

enum RsvpStatus {
  GOING
  MAYBE
  NOT_GOING
}

model MatchRsvp {
  id        String     @id @default(uuid())
  fixtureId String
  fixture   Fixture    @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    RsvpStatus @default(GOING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([fixtureId, userId])
  @@index([userId])
  @@map("match_rsvps")
}

model Poll {
  id           String       @id @default(uuid())
  question     String
  type         String       @default("PLAYER_OF_MATCH")
  fixtureId    String?
  fixture      Fixture?     @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  isActive     Boolean      @default(true)
  closesAt     DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?
  options      PollOption[]
  votes        PollVote[]

  @@index([fixtureId, isActive])
  @@index([deletedAt])
  @@map("polls")
}

model PollOption {
  id       String     @id @default(uuid())
  pollId   String
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label    String
  playerId String?
  player   Player?    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  votes    PollVote[]

  @@index([pollId, id])
  @@map("poll_options")
}

model PollVote {
  id        String     @id @default(uuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([pollId, userId])
  @@index([pollId, optionId])
  @@index([optionId])
  @@map("poll_votes")
}

// ──────────────────────────────────────────────────────────────
// AUDIT
// ──────────────────────────────────────────────────────────────

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@map("activity_logs")
}
